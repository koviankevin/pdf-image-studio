{
  "name": "pdf-image-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "test:ocr": "playwright test scanned-ocr.spec.mjs",
    "test:browser:ui": "playwright test --ui",
    "test:ocr:compare": "playwright test --config playwright.ocr-experiment.config.mjs",
    "test:ocr:conditions": "playwright test scan-conditions.spec.mjs",
    "test:ocr:real": "playwright test --config playwright.real-scans.config.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
